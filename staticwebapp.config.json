{
  "routes": [
    {
      "route": "/workspace*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/api/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/portal*",
      "redirect": "/",
      "statusCode": 302
    },
    {
      "route": "/owner-operators*",
      "redirect": "https://jonedtransport.com/owner-operators/",
      "statusCode": 302
    },
    {
      "route": "/drivers*",
      "redirect": "https://jonedtransport.com/drivers/",
      "statusCode": 302
    },
    {
      "route": "/",
      "allowedRoles": ["anonymous"]
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/.auth/*", "/api/*", "/*.{png,jpg,jpeg,gif,webp,svg,css,js,woff,woff2}"]
  },
  "responseOverrides": {
    "401": {
      "statusCode": 302,
      "redirect": "/.auth/login/aad"
    }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "auth": {
    "identityProviders": {
      "azureActiveDirectory": {
        "registration": {
          "openIdIssuer": "https://login.microsoftonline.com/633f67d8-c5ca-4e0e-97d3-924ef924f9fb/v2.0",
          "clientIdSettingName": "AAD_CLIENT_ID",
          "clientSecretSettingName": "AAD_CLIENT_SECRET"
        }
      }
    }
  }
}
